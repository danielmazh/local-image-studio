# local-image-studio - settings for the private Ollama instance.
# This instance is separate from Ollama.app (127.0.0.1:11434). It has its own
# port, its own model folder and its own logs. Nothing here changes the main app.
# No secrets belong in this file.

# Private server - loopback only, never 0.0.0.0
STUDIO_HOST="127.0.0.1"
STUDIO_PORT="11535"
# Web portal (same loopback address, opened by img-on)
PORTAL_PORT="11536"

# Pinned Ollama for this instance only. Ollama turned off image generation in
# v0.32.6+ (ollama/ollama#17893, "to be re-introduced on the new MLX runner").
# 0.32.5 is the last version that runs x/z-image-turbo. Ollama.app keeps its own version.
# When a new Ollama brings image generation back, point this at the app binary.
STUDIO_OLLAMA_VERSION="0.32.5"
STUDIO_OLLAMA_SHA256="5789dd037a86adb328c72c11fc45e6c558452d07e5b50814a8bdb7b0fbdbcd81"
STUDIO_OLLAMA_BIN="vendor/ollama-0.32.5/ollama"

# Text-to-image model (Ollama library tag)
STUDIO_MODEL="x/z-image-turbo:fp8"

# Interview chat model (abliterated, sees images). Runs on the same private server.
CHAT_MODEL="huihui_ai/qwen3.5-abliterated:27b-q4_K"

# Unload the model from memory after this much idle time while the studio is on.
# 'img-off' stops everything at once.
STUDIO_KEEP_ALIVE="10m"
# The image model leaves memory sooner: it is big and only needed during a job
GEN_KEEP_ALIVE="2m"

# Default image settings
STUDIO_WIDTH="1024"
STUDIO_HEIGHT="1024"
STUDIO_STEPS="9"

# Reference-image engine (Ollama cannot take input images for image models yet).
# mflux runs FLUX.2 klein 4B (Apache 2.0) from a saved 8-bit copy in models/.
# It is a normal process: it starts with 'img-edit' and exits when the image is done.
# To swap the edit model: change these three, then run scripts/setup-edit.sh
EDIT_CMD="mflux-generate-flux2-edit"
EDIT_BASE_MODEL="flux2-klein-4b"
EDIT_MODEL_PATH="models/flux2-klein-4b-q8"
EDIT_STEPS="4"
# Optional LoRA for the edit model: "path scale", e.g. "models/loras/consistency.safetensors 1.0"
EDIT_LORA=""

# Peak memory per model (GB), used for the low-memory warning
CHAT_MEM_GB="18"
GEN_MEM_GB="14"
EDIT_MEM_GB="10"

# Identity quality gate: images made from a face photo are scored (ArcFace, 0-1; two real photos
# of one person score about 0.9). Below QUALITY_MIN the studio makes up to QUALITY_RETRIES more rounds.
QUALITY_MIN="0.90"
QUALITY_RETRIES="2"
